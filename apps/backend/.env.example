APP_NAME=geogent-backend
APP_ENV=development
LOG_LEVEL=INFO

# Async URL for the application.
DATABASE_URL=postgresql+asyncpg://geogent:geogent@localhost:5432/geogent
# Sync URL for Alembic.
DATABASE_URL_SYNC=postgresql+psycopg://geogent:geogent@localhost:5432/geogent

# Comma-separated list of allowed origins (UI dev server, etc.)
CORS_ORIGINS=http://localhost:3000

# JWT settings used by /api/v1/auth.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Routing / geocoding providers (#55). Defaults use the public OSM demo
# services — respect their usage policies and self-host for heavier use.
# OSRM serves routing + travel-time matrix (public demo is 'driving' only).
OSRM_BASE_URL=https://router.project-osrm.org
# Nominatim serves forward + reverse geocoding.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=geogent-backend/0.5 (+https://github.com/julianblue/geogent)
# Isochrones use OpenRouteService (OSRM has none). Endpoint returns 503 until
# ORS_API_KEY is set, or ORS_BASE_URL points at a keyless self-hosted instance.
ORS_BASE_URL=https://api.openrouteservice.org
# ORS_API_KEY=

# TESSERA yearly embeddings (ADR 0003) — anonymous read of the public Icechunk
# store on AWS Open Data. TESSERA_ENABLED=false turns the embedding routes into 503.
TESSERA_ENABLED=true
TESSERA_BUCKET=tessera-embeddings
TESSERA_PREFIX=v1.1/dclimate.icechunk
TESSERA_REGION=us-west-2
TESSERA_BRANCH=main
TESSERA_MIN_YEAR=2017
TESSERA_MAX_YEAR=2025
TESSERA_MAX_YEARS=9
TESSERA_TIMEOUT_SECONDS=120
# Pixel budget of one embedding window (x years for field_embeddings).
TESSERA_LAYER_MAX_PIXELS=1000000
TESSERA_MAX_CONCURRENT_READS=2
TESSERA_YEAR_THREADS=4
