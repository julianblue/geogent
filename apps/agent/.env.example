ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-4-6

# Which architecture to treat as the default for code that needs a single choice.
# Graphs registered in langgraph.json (geogent, geogent-classic) are always
# available independently of this value.
AGENT_ARCHITECTURE=langgraph_react

# Amazon Bedrock (used by the classic-LangChain architecture).
# Credentials are resolved via the standard boto3 chain:
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN,
#   ~/.aws/credentials, or the instance/task IAM role.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

BACKEND_URL=http://localhost:8000

# Service-account credentials the agent uses to authenticate to the backend's
# auth-gated endpoints. These are placeholders — set real values via your
# environment or secret manager. They must match the backend SEED_USER_* values
# for local development.
BACKEND_SERVICE_EMAIL=dev@example.com
BACKEND_SERVICE_PASSWORD=change-me

# LangSmith observability. Set LANGSMITH_TRACING=true and provide an API key
# to forward agent runs to LangSmith. The agent logs the resulting state once
# at startup so misconfiguration is visible. Runs are tagged with
# architecture (langgraph_react|classic_langchain), provider, and model so
# they are filterable in the LangSmith UI.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=geogent
# Optional — set for EU or self-hosted LangSmith.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional — sample a fraction of runs (0.0–1.0). Read by langsmith client.
# LANGSMITH_SAMPLING_RATE=1.0
# Optional — hide inputs/outputs from traces (useful for PII-bearing requests).
# LANGSMITH_HIDE_INPUTS=false
# LANGSMITH_HIDE_OUTPUTS=false
