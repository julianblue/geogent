# Server-side URL used by Next.js to reach the FastAPI backend.
# The browser never calls the backend directly — it goes through /api/proxy/*.
BACKEND_URL=http://localhost:8000

# Server-side URL the LangGraph proxy route forwards to.
# The browser never calls langgraph directly — it goes through /api/lg/*.
LANGGRAPH_URL=http://localhost:2024

# Name of the graph registered in apps/agent/langgraph.json.
# Exposed to the browser so the LangGraph SDK client can target the right
# assistant when streaming runs.
NEXT_PUBLIC_LANGGRAPH_GRAPH_ID=geogent

# Optional. Set when langgraph dev / LangGraph Cloud requires auth.
# LANGCHAIN_API_KEY=
