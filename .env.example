# Shared environment variables for local development.
# Copy to .env and fill in secrets. Never commit .env.

# ----------------------------------------------------------------------------
# Database (PostGIS)
# ----------------------------------------------------------------------------
POSTGRES_USER=geogent
POSTGRES_PASSWORD=geogent
POSTGRES_DB=geogent
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the backend.
DATABASE_URL=postgresql+asyncpg://geogent:geogent@db:5432/geogent
# Sync URL used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://geogent:geogent@db:5432/geogent

# ----------------------------------------------------------------------------
# LLM providers (set at least one)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenRouter (https://openrouter.ai) — OpenAI-compatible gateway to many
# providers. Set the API key and use AGENT_MODEL="openrouter:<vendor>/<model>".
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default chat model used by the agent. The prefix routes to a provider:
#   claude-*                         → Anthropic API     (ANTHROPIC_API_KEY)
#   gpt-*                            → OpenAI API        (OPENAI_API_KEY)
#   bedrock: | anthropic. | us.…     → AWS Bedrock       (boto3 credentials)
#   openrouter:<vendor>/<model>      → OpenRouter        (OPENROUTER_API_KEY)
# Examples:
#   claude-sonnet-4-6
#   gpt-4o
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   openrouter:anthropic/claude-3.5-sonnet
AGENT_MODEL=claude-sonnet-4-6

# ----------------------------------------------------------------------------
# Service URLs (overridden per-service in compose)
# ----------------------------------------------------------------------------
# UI → Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# UI → Agent (via /api/lg proxy → langgraph dev server)
LANGGRAPH_URL=http://localhost:2024
# Name of the graph registered in apps/agent/langgraph.json; exposed to the
# browser so the assistant-ui LangGraph SDK client can target the right graph.
NEXT_PUBLIC_LANGGRAPH_GRAPH_ID=geogent
# Agent → Backend
BACKEND_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Observability (optional) — LangSmith
# ----------------------------------------------------------------------------
# Set TRACING=true and provide an API key to forward runs to LangSmith. The
# agent logs whether tracing was enabled at startup. Runs are tagged with
# architecture / provider / model so they're filterable in the LangSmith UI.
# Use a per-environment project name (e.g. geogent-dev / geogent-prod) so
# local experimentation does not pollute production traces.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=geogent-dev
# Optional — EU or self-hosted LangSmith.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional — sampling and redaction toggles.
# LANGSMITH_SAMPLING_RATE=1.0
# LANGSMITH_HIDE_INPUTS=false
# LANGSMITH_HIDE_OUTPUTS=false
