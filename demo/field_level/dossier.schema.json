{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geogent/field_dossier/v0",
  "title": "Field dossier",
  "description": "Per-field multi-layer summary. Every block names the validated signal it rests on (evidence keys -> FINDINGS.md sections). Values are null when the layer is missing for that year.",
  "type": "object",
  "required": ["field", "coverage", "history", "rotation_profile", "management", "performance", "within_field", "anomalies", "boundary", "evidence", "narrative"],
  "properties": {
    "field": {"type": "object", "required": ["uid", "window", "area_ha", "centroid_lonlat", "ref_year"],
      "properties": {"uid": {"type": "string"}, "window": {"type": "string"}, "area_ha": {"type": "number"},
        "centroid_lonlat": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "ref_year": {"type": "integer", "description": "declaration year whose parcel geometry defines the unit"}}},
    "coverage": {"type": "object", "properties": {"years": {"type": "array", "items": {"type": "integer"}},
      "declared_years": {"type": "integer"}, "s2_clear_obs_per_year": {"type": "object"}, "tessera_px": {"type": "integer"}}},
    "history": {"type": "array", "items": {"type": "object", "required": ["year"], "properties": {
      "year": {"type": "integer"}, "declared": {"type": ["string", "null"]}, "group": {"type": ["string", "null"]},
      "embedding_group": {"type": ["string", "null"], "description": "LOYO TESSERA crop-group prediction; fills untracked years"},
      "p_declared_group": {"type": ["number", "null"]}, "yoy_centred_distance": {"type": ["number", "null"]},
      "phenology_change": {"type": ["boolean", "null"], "description": "centred YoY distance >= 0.5"},
      "declared_change": {"type": ["boolean", "null"]}, "flags": {"type": "array", "items": {"type": "string"}}}}},
    "rotation_profile": {"type": "object", "properties": {"n_years": {"type": "integer"}, "cereal_share": {"type": "number"}, "n_crops": {"type": "integer"},
      "group_entropy_bits": {"type": "number"}, "max_monoculture_run": {"type": "integer"}, "declared_changes": {"type": "integer"},
      "embedding_changes": {"type": "integer"}, "disagreements": {"type": "integer"}, "percentile_in_window": {"type": "object"}}},
    "management": {"type": "array", "items": {"type": "object", "properties": {"year": {"type": "integer"}, "sos_doy": {"type": ["integer", "null"]},
      "peak_doy": {"type": ["integer", "null"]}, "harvest_doy": {"type": ["integer", "null"]}, "season_len_d": {"type": ["integer", "null"]},
      "n_cycles": {"type": ["integer", "null"]}, "winter_cover": {"enum": ["green", "bare", "ambiguous", "n/a", null]},
      "winter_green_kind": {"enum": ["cover/catch", "autumn-sown next crop", null]}, "bare_soil_days": {"type": ["integer", "null"]}}}},
    "performance": {"type": "object", "properties": {"by_year": {"type": "array"}, "summary": {"type": "object"}}},
    "within_field": {"type": ["object", "null"], "properties": {"n_px": {"type": "integer"}, "n_years": {"type": "integer"},
      "stability_rho": {"type": "number"}, "split_half_rho": {"type": "number"}, "persistent_low_frac": {"type": "number"},
      "persistent_low_expected_by_chance": {"type": "number"}, "low_zone_direction": {"type": ["string", "null"]},
      "terrain": {"type": ["object", "null"]}}},
    "anomalies": {"type": "array", "items": {"type": "object", "properties": {"year": {"type": "integer"},
      "traj_dev_season_z": {"type": ["number", "null"]}, "emb_dev_z": {"type": ["number", "null"]}, "events": {"type": "array", "items": {"type": "string"}}}}},
    "boundary": {"type": ["object", "null"], "properties": {"pred_best_iou": {"type": ["number", "null"]}, "pred_split": {"type": ["boolean", "null"]}}},
    "maci": {"type": ["object", "null"], "description": "PLACEHOLDER until 'MACI' is defined"},
    "evidence": {"type": "object", "additionalProperties": {"type": "string"}},
    "narrative": {"type": "string"}
  }
}
